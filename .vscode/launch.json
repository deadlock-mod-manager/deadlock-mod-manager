{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Development Debug",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./src-tauri/Cargo.toml",
          "--no-default-features"
        ],
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "preLaunchTask": "ui:dev",
      "cwd": "${workspaceFolder}/apps/desktop"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Production Debug",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=./src-tauri/Cargo.toml"
        ],
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "preLaunchTask": "ui:build",
      "cwd": "${workspaceFolder}/apps/desktop"
    }
  ]
}

{
  "folders": [
    {
      "path": "..",
    },
  ],
  "settings": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
    },
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.preferences.importModuleSpecifier": "shortest",
    "js/ts.preferences.importModuleSpecifierEnding": "auto",
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "oxc.path.oxfmt": "./node_modules/.bin/oxfmt",
    "oxc.path.oxlint": "./node_modules/.bin/oxlint",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    // TypeScript performance optimizations
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
    "js/ts.preferences.includePackageJsonAutoImports": "off",
    "js/ts.suggest.autoImports": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.suggest.completeFunctionCalls": false,
    "js/ts.suggest.jsdoc.generateReturns": false,
    "js/ts.workspaceSymbols.scope": "currentProject",
    // File exclusions for better performance
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": false,
      "**/build": true,
      "**/target": true,
      "**/.turbo": true,
      "**/.tsbuildinfo": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/.turbo": true,
      "**/.tsbuildinfo": true,
      "**/pnpm-lock.yaml": true,
      "**/routeTree.gen.ts": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/target/**": true,
      "**/.turbo/**": true,
      "**/.tsbuildinfo": true,
      "**/routeTree.gen.ts": true,
    },
    "files.readonlyInclude": {
      "**/routeTree.gen.ts": true,
    },
    "rust-analyzer.linkedProjects": [
      "apps/desktop/Cargo.toml",
      "packages/dmp-parser/Cargo.toml",
      "packages/dmodpkg/Cargo.toml",
      "packages/hero-parser/Cargo.toml",
      "packages/kv-parser/Cargo.toml",
      "packages/vpk-parser/Cargo.toml",
    ],
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
    },
    "[xml]": {
      "editor.defaultFormatter": "redhat.vscode-xml",
    },
    "cSpell.words": [
      "dlmm",
      "modmanager"
    ],
  },
}